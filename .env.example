# Environment Variables Template

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id
S3_BUCKET_NAME=dms-documents-bucket
DYNAMODB_DOCUMENTS_TABLE=dms_documents
DYNAMODB_VERSIONS_TABLE=dms_versions
DYNAMODB_AUDIT_LOG_TABLE=dms_audit_logs

# Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_DOMAIN=your-cognito-domain

# API Configuration
API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
API_TIMEOUT=30000

# Frontend Configuration
ANGULAR_ENV=production
API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
LOG_LEVEL=info

# Backend Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://yourdomain.com
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# S3 Configuration
S3_PRESIGNED_URL_EXPIRATION=3600
S3_ENCRYPTION_TYPE=AES256
S3_MAX_FILE_SIZE=5368709120  # 5GB

# DynamoDB Configuration
DYNAMODB_READ_CAPACITY=10
DYNAMODB_WRITE_CAPACITY=10

# Monitoring
CLOUDWATCH_LOG_GROUP=/aws/lambda/dms
ENABLE_XRAY=true

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your-password

# Application
APP_NAME=Document Management System
APP_VERSION=1.0.0
SUPPORT_EMAIL=support@example.com
